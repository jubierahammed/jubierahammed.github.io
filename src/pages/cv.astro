---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Entry from '../components/Entry.astro';
import {
  interests,
  education,
  researchExperience,
  teachingExperience,
  awards,
  skills,
  languages,
} from '../data/profile';
import { publications } from '../data/publications';

const cvPdf = '/cv/Ahammed_CV.pdf';
const underReview = publications.filter((p) => p.kind === 'preprint');
const inPreparation = publications.filter((p) => p.kind === 'in-preparation');
const conference = publications.filter((p) => p.kind === 'conference');
const hasCorresponding = publications.some((p) => p.authors.includes('*'));
---

<BaseLayout
  title="CV"
  description="Curriculum vitae of Md Jubier Ahammed: education, research and teaching experience, publications, awards, and technical skills."
>
  <PageHeader title="Curriculum Vitae">
    <p>Graduate researcher in Geography and Environmental Studies, Texas Tech University.</p>
    <p class="cv-download no-justify">
      <a class="button" href={cvPdf}>Download CV (PDF)</a>
    </p>
  </PageHeader>

  <section class="cv-section" aria-labelledby="cv-education">
    <h2 id="cv-education">Education</h2>
    {
      education.map((e) => (
        <Entry
          title={e.degree}
          org={`${e.institution}, ${e.location}`}
          dates={e.dates}
          meta={`GPA: ${e.gpa}`}
          logo={e.logo}
          logoAlt={e.logoAlt}
        >
          <p>
            Thesis: <em>{e.thesis}</em>
            {e.advisor && <Fragment>. Advisor: {e.advisor}.</Fragment>}
          </p>
        </Entry>
      ))
    }
  </section>

  <section class="cv-section" aria-labelledby="cv-interests">
    <h2 id="cv-interests">Research Interests</h2>
    <p>{interests.map((i) => i.title).join('; ')}.</p>
  </section>

  <section class="cv-section" aria-labelledby="cv-research">
    <h2 id="cv-research">Research Experience</h2>
    {
      researchExperience.map((p) => (
        <Entry title={p.title} org={p.org} dates={p.dates} meta={p.meta}>
          <ul>
            {p.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </Entry>
      ))
    }
  </section>

  <section class="cv-section" aria-labelledby="cv-teaching">
    <h2 id="cv-teaching">Teaching Experience</h2>
    {
      teachingExperience.map((p) => (
        <Entry title={p.title} org={p.org} dates={p.dates} meta={p.meta}>
          <ul>
            {p.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </Entry>
      ))
    }
  </section>

  <section class="cv-section" aria-labelledby="cv-publications">
    <h2 id="cv-publications">Publications</h2>

    <h3 class="cv-subheading">Under Review</h3>
    <ul class="cv-list">
      {
        underReview.map((p) => (
          <li>
            {p.authors} {p.title}. Under review, <em>{p.venue}</em>.
            {p.doi && (
              <Fragment>
                {' '}
                Preprint: <a href={`https://doi.org/${p.doi}`} rel="noopener">{p.doi}</a>
              </Fragment>
            )}
          </li>
        ))
      }
    </ul>
    {hasCorresponding && <p class="cv-note no-justify">*Corresponding author</p>}

    {
      inPreparation.length > 0 && (
        <Fragment>
          <h3 class="cv-subheading">In Preparation</h3>
          <ul class="cv-list">
            {inPreparation.map((p) => (
              <li>
                {p.authors} {p.title}.
              </li>
            ))}
          </ul>
        </Fragment>
      )
    }

    {
      conference.length > 0 && (
        <Fragment>
          <h3 class="cv-subheading">Conference Presentations</h3>
          <ul class="cv-list">
            {conference.map((p) => (
              <li>
                {p.authors} {p.title}. {p.venue}.
              </li>
            ))}
          </ul>
        </Fragment>
      )
    }
  </section>

  <section class="cv-section" aria-labelledby="cv-awards">
    <h2 id="cv-awards">Awards, Fellowships &amp; Funding</h2>
    <ul class="cv-list">
      {awards.map((a) => <li>{a}</li>)}
    </ul>
  </section>

  <section class="cv-section" aria-labelledby="cv-projects">
    <h2 id="cv-projects">Class Projects</h2>
    <ul class="cv-list">
      <li>
        <a href="/projects/#buffalo-commons">Site Suitability Analysis for a Bison Preserve ("Buffalo Commons")</a>.
        Multi-criteria weighted suitability model in ArcGIS Pro across ten Great Plains states.
      </li>
      <li>
        <a href="/projects/#ev-charging">Spatial Database for EV Charging Deserts in Texas</a>. PostgreSQL/PostGIS
        spatial database and spatial SQL queries relating charger locations, highways, and census tracts.
      </li>
      <li>
        <a href="/projects/#lubbock-rent">Hedonic Rent Pricing Model, Lubbock, Texas</a>. OLS regression in R modeling
        monthly rent against unit attributes and neighborhood income, with diagnostics.
      </li>
    </ul>
    <p class="cv-note no-justify">
      Full write-ups, maps, and source code are on the <a href="/projects/">Projects</a> page.
    </p>
  </section>

  <section class="cv-section" aria-labelledby="cv-skills">
    <h2 id="cv-skills">Technical Skills</h2>
    <dl class="skills">
      {
        skills.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.items}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="cv-section" aria-labelledby="cv-languages">
    <h2 id="cv-languages">Languages</h2>
    <dl class="skills">
      {
        languages.map((l) => (
          <div>
            <dt>{l.label}</dt>
            <dd>{l.items}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <p class="cv-download cv-download--bottom no-justify">
    <a class="button" href={cvPdf}>Download CV (PDF)</a>
  </p>
</BaseLayout>

<style>
  .button {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background 120ms ease, color 120ms ease;
  }

  .button:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .cv-download {
    margin: 1rem 0 0;
  }

  .cv-download--bottom {
    margin-top: var(--section-gap);
  }

  .cv-section + .cv-section {
    margin-top: 3rem;
  }

  .cv-section h2 {
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cv-section :global(.entry__content ul) {
    margin: 0.25rem 0 0;
    padding-left: 1.1rem;
    color: var(--color-text-muted);
  }

  .cv-section :global(.entry__content li) {
    text-align: justify;
    hyphens: auto;
  }

  .cv-subheading {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 1.5rem 0 0.6rem;
  }

  .cv-subheading:first-of-type {
    margin-top: 0;
  }

  .cv-list {
    padding-left: 1.1rem;
    margin: 0;
  }

  .cv-list li {
    text-align: justify;
    hyphens: auto;
  }

  .cv-list li + li {
    margin-top: 0.5rem;
  }

  .cv-note {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem 2rem;
    margin: 0;
  }

  .skills dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .skills dd {
    margin: 0;
  }
</style>
