---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ResearchCard from '../components/ResearchCard.astro';
import portrait from '../assets/jubier-ahammed.png';
import {
  tagline,
  interestsStatement,
  interests,
  education,
  researchExperience,
  teachingExperience,
  contact,
} from '../data/profile';
import { publications } from '../data/publications';

const featured = publications.filter((p) => p.featured);
const positions = [...researchExperience, ...teachingExperience].filter((p) => !p.collaboration);
---

<BaseLayout>
  <!-- Bio / intro -->
  <section id="about" class="hero" aria-labelledby="about-heading">
    <div class="hero__text">
      <p class="eyebrow">Geography &amp; Environmental Studies · Texas Tech University</p>
      <h1 id="about-heading">Md Jubier Ahammed</h1>
      <p class="hero__tagline no-justify">{tagline.lead}<br />{tagline.rest}</p>
      <p>
        I got into this field watching disasters unfold, floods, storms, the changing shape of coastlines, and
        wanting to understand not just where these hazards strike, but who ends up bearing the cost. That question
        sits behind everything I work on now, as a graduate student in Geography and Environmental Studies at Texas
        Tech University.
      </p>
      <p>
        My work connects disaster risk, GIS, remote sensing, and machine learning, using satellite data and modeling
        to map how landscapes change and where people are most exposed, then asking what that means for the
        communities living there. My background in Disaster and Human Security Management keeps that human dimension
        central, even when the tools are technical. Before my MS, I worked at CEGIS on land use/land cover mapping
        and at CHIRAL on GIS based spatial analysis of disease outbreaks, both in Bangladesh, experience that shaped
        how I think about applying remote sensing to real, on the ground risk. I currently serve as a graduate
        teaching assistant.
      </p>
      <ul class="hero__links">
        <li><a href="#interests">Research interests</a></li>
        <li><a href="#research">Featured research</a></li>
        <li><a href="/cv/">Curriculum vitae</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
    <figure class="hero__portrait">
      <Image src={portrait} alt="Md Jubier Ahammed" width={480} height={480} loading="eager" />
    </figure>
  </section>

  <!-- Research interests -->
  <section id="interests" class="interests" aria-labelledby="interests-heading">
    <p class="eyebrow">Research Interests</p>
    <h2 id="interests-heading" class="interests__statement">{interestsStatement}</h2>
    <ul class="interests__grid">
      {
        interests.map((item) => (
          <li class="interest">
            <h3 class="interest__title">{item.title}</h3>
            <p class="interest__blurb no-justify">{item.blurb}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Compact overview: education and positions. Full detail lives on the CV page. -->
  <Section id="background" title="Background">
    <div class="overview">
      <div class="overview__col">
        <h3 class="overview__heading">Education</h3>
        <ul class="overview__list">
          {
            education.map((e) => (
              <li class="overview__item overview__item--logo">
                <Image src={e.logo} alt={e.logoAlt} width={96} height={96} class="overview__logo" />
                <div>
                  <p class="overview__title no-justify">{e.degree}</p>
                  <p class="overview__meta no-justify">
                    {e.institution} · {e.dates}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="overview__col">
        <h3 class="overview__heading">Positions</h3>
        <ul class="overview__list">
          {
            positions.map((p) => (
              <li class="overview__item">
                <p class="overview__title no-justify">{p.title}</p>
                <p class="overview__meta no-justify">
                  {p.org ? `${p.org} · ` : ''}
                  {p.dates}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="section-link no-justify">
      <a href="/cv/">Full CV with thesis details, responsibilities, awards, and skills</a>
    </p>
  </Section>

  <Section id="research" title="Featured Research">
    {featured.map((p) => <ResearchCard title={p.title} status={p.status} href={`/publications/#${p.id}`} />)}
    <p class="section-link no-justify">
      <a href="/publications/">All publications</a> · <a href="/research/">Thesis and ongoing research</a>
    </p>
  </Section>

  <Section id="contact" title="Contact">
    <dl class="contact">
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
      </div>
      <div>
        <dt>Location</dt>
        <dd>{contact.location}</dd>
      </div>
      <div>
        <dt>LinkedIn</dt>
        <dd><a href={contact.linkedin.url} rel="me noopener">{contact.linkedin.name}</a></dd>
      </div>
      <div>
        <dt>ORCID</dt>
        <dd><a href={contact.orcid.url} rel="me noopener">{contact.orcid.id}</a></dd>
      </div>
      <div>
        <dt>Google Scholar</dt>
        <dd><a href={contact.scholar.url} rel="me noopener">{contact.scholar.name}</a></dd>
      </div>
      <div>
        <dt>CV</dt>
        <dd><a href="/cv/">Curriculum vitae</a></dd>
      </div>
    </dl>
  </Section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem 3rem;
    align-items: start;
    margin-bottom: var(--section-gap);
  }

  .hero h1 {
    margin-bottom: 0.5rem;
  }

  .hero__text p {
    max-width: none;
  }

  .hero__tagline {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    color: var(--color-text-muted);
    line-height: 1.5;
    text-wrap: balance;
    margin-bottom: 1.5rem;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .hero__links li {
    margin: 0;
  }

  .hero__portrait {
    margin: 0;
    width: 13rem;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.9) translateY(21%);
  }

  /* ---- Research interests ---- */
  .interests {
    scroll-margin-top: 1.5rem;
    margin-bottom: var(--section-gap);
  }

  .interests__statement {
    font-size: var(--text-2xl);
    font-weight: 400;
    max-width: 30ch;
    text-wrap: balance;
    margin-bottom: 1.75rem;
  }

  .interests__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .interest {
    margin: 0;
    padding: 1.1rem 1.25rem 1.2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
  }

  .interest__title {
    font-size: var(--text-md);
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  .interest__blurb {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  /* ---- Background overview ---- */
  .overview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem 3rem;
  }

  .overview__heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .overview__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .overview__item + .overview__item {
    margin-top: 1rem;
  }

  .overview__item--logo {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }

  .overview__logo {
    flex: 0 0 3rem;
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }

  .overview__title {
    margin: 0;
    font-weight: 600;
  }

  .overview__meta {
    margin: 0.1rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .section-link {
    margin: 1.5rem 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  /* ---- Contact ---- */
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
  }

  .contact dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .contact dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 40rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero__portrait {
      order: -1;
      width: 9rem;
    }

    .interests__statement {
      font-size: var(--text-xl);
    }
  }
</style>
