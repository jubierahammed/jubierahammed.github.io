---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ResearchProject from '../components/ResearchProject.astro';
import { publications, displayAuthors } from '../data/publications';

const preprints = publications.filter((p) => p.kind === 'preprint');
const conference = publications.filter((p) => p.kind === 'conference');
---

<BaseLayout
  title="Publications"
  description="Preprints and conference presentations by Md Jubier Ahammed on post-storm recovery, compound heat-flood exposure, and land cover change."
>
  <PageHeader title="Publications">
    <p>Manuscripts under review, with preprints available, and conference presentations.</p>
  </PageHeader>

  <section id="preprints" class="group" aria-labelledby="preprints-heading">
    <h2 id="preprints-heading">Preprints · Under Review</h2>
    {
      preprints.map((p) => (
        <ResearchProject
          id={p.id}
          title={p.title}
          status={p.status}
          authors={displayAuthors[p.id] ?? p.authors}
          abstract={p.abstract}
          doi={p.doi}
          pdf={p.pdf}
          methods={p.methods}
        >
          {p.narrative && <p>{p.narrative}</p>}
        </ResearchProject>
      ))
    }
  </section>

  {
    conference.length > 0 && (
      <section id="presentations" class="group" aria-labelledby="presentations-heading">
        <h2 id="presentations-heading">Conference Presentations</h2>
        <ul class="presentations">
          {conference.map((p) => (
            <li>
              {p.authors} "{p.title}." {p.venue}.
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .group + .group {
    margin-top: var(--section-gap);
  }

  .group h2 {
    margin-bottom: 1.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .presentations {
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .presentations li {
    text-align: justify;
    hyphens: auto;
  }
</style>
