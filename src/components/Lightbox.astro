---
/**
 * Page-level image viewer. Include once per page that uses <Gallery />.
 * Any <a data-lightbox data-caption="..."> opens here; arrow keys move
 * within the same gallery. Re-initialises after client-side navigation.
 */
---

<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
  <button type="button" class="lightbox__close" data-close aria-label="Close">×</button>
  <button type="button" class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Previous image">‹</button>
  <figure class="lightbox__figure">
    <img alt="" />
    <figcaption class="no-justify"></figcaption>
  </figure>
  <button type="button" class="lightbox__nav lightbox__nav--next" data-next aria-label="Next image">›</button>
</dialog>

<script>
  let group: HTMLAnchorElement[] = [];
  let index = 0;

  function currentDialog() {
    return document.getElementById('lightbox') as HTMLDialogElement | null;
  }

  function show(i: number) {
    const dialog = currentDialog();
    if (!dialog || group.length === 0) return;
    index = (i + group.length) % group.length;
    const link = group[index];
    const img = dialog.querySelector('img') as HTMLImageElement;
    const caption = dialog.querySelector('figcaption') as HTMLElement;
    img.src = link.href;
    img.alt = link.dataset.caption ?? '';
    caption.textContent = link.dataset.caption ?? '';
    const single = group.length < 2;
    (dialog.querySelector('[data-prev]') as HTMLButtonElement).hidden = single;
    (dialog.querySelector('[data-next]') as HTMLButtonElement).hidden = single;
  }

  function setup() {
    const dialog = currentDialog();
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = 'true';

    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    dialog.addEventListener('close', () => {
      dialog.querySelector('img')?.removeAttribute('src');
    });
  }

  // One delegated listener for the whole document; survives page swaps.
  if (!(window as any).__lightboxDelegated) {
    (window as any).__lightboxDelegated = true;
    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a[data-lightbox]') as HTMLAnchorElement | null;
      if (!link) return;
      const dialog = currentDialog();
      if (!dialog) return;
      event.preventDefault();
      const scope = link.closest('.gallery') ?? document;
      group = Array.from(scope.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));
      show(group.indexOf(link));
      dialog.showModal();
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox[open] {
    display: flex;
  }

  .lightbox::backdrop {
    background: rgba(18, 12, 34, 0.88);
  }

  .lightbox__figure {
    margin: 0;
    max-width: min(92vw, 1600px);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: #fff;
    border-radius: var(--radius);
  }

  .lightbox__figure figcaption {
    color: #f2f2f2;
    font-size: var(--text-sm);
    text-align: center;
    max-width: 60ch;
  }

  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    background: rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav--prev {
    left: 1rem;
  }

  .lightbox__nav--next {
    right: 1rem;
  }
</style>
