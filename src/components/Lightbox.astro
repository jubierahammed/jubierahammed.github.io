---
/**
 * Page-level image viewer. Include once per page that uses <Gallery />.
 * Any <a data-lightbox data-caption="..."> opens here; arrow keys move
 * within the same gallery.
 */
---

<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
  <button type="button" class="lightbox__close" data-close aria-label="Close">×</button>
  <button type="button" class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Previous image">‹</button>
  <figure class="lightbox__figure">
    <img alt="" />
    <figcaption class="no-justify"></figcaption>
  </figure>
  <button type="button" class="lightbox__nav lightbox__nav--next" data-next aria-label="Next image">›</button>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const img = dialog.querySelector('img') as HTMLImageElement;
    const caption = dialog.querySelector('figcaption') as HTMLElement;
    const prevBtn = dialog.querySelector('[data-prev]') as HTMLButtonElement;
    const nextBtn = dialog.querySelector('[data-next]') as HTMLButtonElement;

    let group: HTMLAnchorElement[] = [];
    let index = 0;

    function show(i: number) {
      index = (i + group.length) % group.length;
      const link = group[index];
      img.src = link.href;
      img.alt = link.dataset.caption ?? '';
      caption.textContent = link.dataset.caption ?? '';
      const single = group.length < 2;
      prevBtn.hidden = single;
      nextBtn.hidden = single;
    }

    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a[data-lightbox]') as HTMLAnchorElement | null;
      if (!link) return;
      event.preventDefault();
      const scope = link.closest('.gallery') ?? document;
      group = Array.from(scope.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));
      show(group.indexOf(link));
      dialog.showModal();
    });

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
    });
  }
</script>

<style>
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox[open] {
    display: flex;
  }

  .lightbox::backdrop {
    background: rgba(20, 24, 20, 0.88);
  }

  .lightbox__figure {
    margin: 0;
    max-width: min(92vw, 1600px);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: #fff;
    border-radius: var(--radius);
  }

  .lightbox__figure figcaption {
    color: #f2f2f2;
    font-size: var(--text-sm);
    text-align: center;
    max-width: 60ch;
  }

  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 0;
    border-radius: 50%;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav--prev {
    left: 1rem;
  }

  .lightbox__nav--next {
    right: 1rem;
  }
</style>
