---
/**
 * A CV-style entry: dates in a left column, title/organization/details on the right.
 * Used for education, experience, and teaching on the home page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  org?: string;
  dates: string;
  /** Small secondary line under the title, e.g. GPA or location. */
  meta?: string;
  /** Optional institution logo shown beside the entry text. */
  logo?: ImageMetadata;
  logoAlt?: string;
}

const { title, org, dates, meta, logo, logoAlt = '' } = Astro.props;
---

<article class="entry">
  <div class="entry__aside">
    <p class="entry__dates no-justify">{dates}</p>
    {
      logo && (
        <div class="entry__logo">
          <Image src={logo} alt={logoAlt} width={176} height={176} />
        </div>
      )
    }
  </div>
  <div class="entry__body">
    <div class="entry__text">
      <h3 class="entry__title">{title}</h3>
      {org && <p class="entry__org no-justify">{org}</p>}
      {meta && <p class="entry__meta no-justify">{meta}</p>}
      <div class="entry__content">
        <slot />
      </div>
    </div>
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
  }

  .entry + .entry {
    margin-top: 1.75rem;
  }

  .entry__dates {
    margin: 0;
    padding-top: 0.2rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .entry__aside {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .entry__logo {
    width: 5.5rem;
    height: 5.5rem;
  }

  .entry__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .entry__text {
    min-width: 0;
    flex: 1 1 auto;
  }

  .entry__title {
    font-size: var(--text-md);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .entry__org {
    margin: 0 0 0.15rem;
    color: var(--color-text);
  }

  .entry__meta {
    margin: 0 0 0.35rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .entry__content :global(p) {
    margin-bottom: 0.5em;
    color: var(--color-text-muted);
  }

  .entry__content :global(p:last-child) {
    margin-bottom: 0;
  }

  .entry__content :global(em) {
    color: var(--color-text);
  }

  @media (max-width: 40rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .entry__dates {
      padding-top: 0;
      font-size: 0.8rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .entry__aside {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.35rem;
    }

    .entry__logo {
      width: 3rem;
      height: 3rem;
      order: -1;
    }
  }
</style>
