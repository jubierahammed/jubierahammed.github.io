---
const { pathname } = Astro.url;

const links = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  { href: '/projects/', label: 'Projects' },
  { href: '/publications/', label: 'Publications' },
  { href: '/cv/', label: 'CV' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href.replace(/\/$/, ''));
}
---

<header class="site-header" transition:animate="none">
  <div class="container container--wide site-header__inner">
    <a href="/" class="site-header__brand">Jubier Ahammed</a>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.6), inset 0 3px 0 var(--color-accent);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: var(--color-bg);
    }
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.1rem;
  }

  .site-header__brand {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-header__brand:hover {
    color: var(--color-accent);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav li {
    margin: 0;
  }

  .site-nav a {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 1.5px solid transparent;
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  .site-nav a[aria-current='page'] {
    color: var(--color-accent);
    border-bottom: 2px solid var(--color-highlight);
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      padding-block: 0.9rem;
    }
  }
</style>
