---
/**
 * Full project write-up block for the Research page.
 * Slot holds the narrative paragraphs. Pass `abstract` for papers with a preprint.
 */
interface Props {
  id: string;
  title: string;
  status: string;
  authors?: string;
  abstract?: string;
  /** Bare DOI, e.g. "10.20944/preprints202609.0372.v1". */
  doi?: string;
  /** Site-relative path to a hosted PDF. */
  pdf?: string;
  methods?: string;
}

const { id, title, status, authors, abstract, doi, pdf, methods } = Astro.props;
const hasLinks = Boolean(doi || pdf);
---

<article id={id} class="project" aria-labelledby={`${id}-title`}>
  <p class="project__status no-justify">{status}</p>
  <h3 id={`${id}-title`} class="project__title">{title}</h3>
  {authors && <p class="project__authors no-justify">{authors}</p>}

  <div class="project__body">
    <slot />
  </div>

  {
    abstract && (
      <div class="project__abstract">
        <p class="project__label no-justify">Abstract</p>
        <p>{abstract}</p>
      </div>
    )
  }

  {
    hasLinks && (
      <p class="project__links no-justify">
        {doi && (
          <span>
            DOI: <a href={`https://doi.org/${doi}`} rel="noopener">{doi}</a>
          </span>
        )}
        {pdf && (
          <a href={pdf} rel="noopener">
            Preprint PDF
          </a>
        )}
      </p>
    )
  }

  {methods && <p class="project__methods no-justify"><strong>Methods:</strong> {methods}</p>}
</article>

<style>
  .project {
    scroll-margin-top: 1.5rem;
  }

  .project + .project {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .project__status {
    margin: 0 0 0.35rem;
    max-width: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .project__title {
    font-size: var(--text-lg);
    margin-bottom: 0.35rem;
  }

  .project__authors {
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project__body :global(p) {
    max-width: none;
  }

  .project__abstract {
    margin: 1.25rem 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-accent-soft);
    background: var(--color-surface);
  }

  .project__abstract p {
    max-width: none;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin: 0 0 0.35rem;
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0.75rem 0 0;
    max-width: none;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .project__links a {
    overflow-wrap: anywhere;
  }

  .project__methods {
    margin: 0.75rem 0 0;
    max-width: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .project__methods strong {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
