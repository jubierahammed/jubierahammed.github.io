---
/**
 * Thumbnail grid for a project's maps and plots. Each thumbnail opens the
 * full-size optimized image in the page-level <Lightbox />.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryImage {
  src: ImageMetadata;
  caption: string;
}

interface Props {
  images: GalleryImage[];
  /** Thumbnail column count on wide screens. Defaults to 3. */
  columns?: 2 | 3 | 4;
}

const { images, columns = 3 } = Astro.props;

const fullSize = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: 1800, format: 'webp', quality: 82 }))
);
---

<ul class:list={['gallery', `gallery--${columns}`]}>
  {
    images.map((img, i) => (
      <li class="gallery__item">
        <figure>
          <a href={fullSize[i].src} data-lightbox data-caption={img.caption} class="gallery__link">
            <Image src={img.src} alt={img.caption} width={720} format="webp" quality={78} loading="lazy" />
          </a>
          <figcaption class="no-justify">{img.caption}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .gallery li {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .gallery--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .gallery--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  figure {
    margin: 0;
  }

  .gallery__link {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 120ms ease;
  }

  .gallery__link:hover {
    border-color: var(--color-accent);
  }

  .gallery__link img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }
</style>
